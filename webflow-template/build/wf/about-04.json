{"html": "<section class=\"section\"><div class=\"container stack-l\"><div class=\"row is-between\"><div class=\"stack-m\"><div class=\"eyebrow\"><span class=\"eyebrow-index\">03</span><span class=\"eyebrow-line\"></span>The team</div><h2 class=\"heading-l\">Hands behind&nbsp;<span class=\"h-italic\">the counter</span></h2></div><a href=\"/contact\" class=\"button is-secondary\">Join the team</a></div><div class=\"grid-4\"><div class=\"team-card\"><div class=\"team-image-wrap\"><img class=\"zoom-image\" src=\"https://s3.amazonaws.com/webflow-prod-assets/6a3434fba4e1760c6191fcc1/6ab96d417eb59be05ccf3877_team-chef-1.jpg\" alt=\"Kenji Arata\"></div><div><div class=\"heading-xs\">Kenji Arata</div><div class=\"small muted\">Head chef &amp; founder</div></div></div><div class=\"team-card\"><div class=\"team-image-wrap\"><img class=\"zoom-image\" src=\"https://s3.amazonaws.com/webflow-prod-assets/6a3434fba4e1760c6191fcc1/6ab96d427eb59be05ccf3899_team-chef-2.jpg\" alt=\"Yuna Mori\"></div><div><div class=\"heading-xs\">Yuna Mori</div><div class=\"small muted\">Sushi chef</div></div></div><div class=\"team-card\"><div class=\"team-image-wrap\"><img class=\"zoom-image\" src=\"https://s3.amazonaws.com/webflow-prod-assets/6a3434fba4e1760c6191fcc1/6ab96d404b1fcb9489e1caf4_robata-grill-1.jpg\" alt=\"Leo Santos\"></div><div><div class=\"heading-xs\">Leo Santos</div><div class=\"small muted\">Robata grill</div></div></div><div class=\"team-card\"><div class=\"team-image-wrap\"><img class=\"zoom-image\" src=\"https://s3.amazonaws.com/webflow-prod-assets/6a3434fba4e1760c6191fcc1/6ab96d425cd223a118adc92b_team-chef-4.jpg\" alt=\"Theo Brandt\"></div><div><div class=\"heading-xs\">Theo Brandt</div><div class=\"small muted\">Pastry &amp; sweets</div></div></div></div></div></section>", "css": ".grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; grid-column-gap: 24px; grid-row-gap: 40px; } .team-card { display: flex; flex-direction: column; grid-row-gap: 16px; } .team-image-wrap { border-radius: 24px; overflow: hidden; height: 380px; } @media screen and (max-width: 991px) { .grid-4 { grid-template-columns: 1fr 1fr; } } @media screen and (max-width: 767px) { .grid-4 { grid-template-columns: 1fr; } } "}